{
  "expo": {
    "name": "Hackathon App",
    "slug": "bpm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.willdupont.bpm",
      "infoPlist": {
        "NSAppleMusicUsageDescription": "BPM plays songs from your Apple Music library and adjusts their tempo to match your heart rate.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "dbe17b9b-3c76-46e0-9684-40e8f975e7e0"
      }
    },
    "owner": "bpm-emergent"
  }
}
