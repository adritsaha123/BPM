# Copy to .env and fill in. NEVER commit .env.

# Leave blank to use MOCK AI responses (handy before you have a key).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Comma-separated origins allowed to call the API ("*" is fine for a hackathon)
CORS_ORIGINS=*

# WHOOP app credentials from developer-dashboard.whoop.com (app "BPM").
# Leave blank to serve MOCK WHOOP data. See docs/WHOOP.md.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Must exactly match a Redirect URL on the WHOOP app.
# - Laptop-only login: http://localhost:8000/whoop/callback
# - "Connect Whoop" in the app: your public tunnel, e.g. https://your-name.ngrok-free.app/whoop/callback
#   (dev.ps1 -NgrokDomain / dev.sh --ngrok set this for you)
WHOOP_REDIRECT_URI=http://localhost:8000/whoop/callback
